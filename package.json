{
  "name": "webg-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "models/birefnet-lite-512.json",
    "models/yolos-tiny-416.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs && tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:batch": "node test/batch-smoke.mjs",
    "verify:model": "node scripts/verify-model.mjs",
    "batch": "npm run build && node scripts/batch-cutouts.mjs",
    "batch:768": "npm run batch -- img-tests/photosets/photoset-1 img-tests/outputs/outputs-768 models/birefnet-lite-768.json"
  },
  "dependencies": {
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.3"
  }
}
